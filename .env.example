# --- General ---
BABBEL_LOCALE=nl-BE
BABBEL_TIMEZONE=Europe/Brussels
DATABASE_URL=sqlite:///./babbel.db
BABBEL_ADMIN_TOKEN=change-me-admin
BABBEL_SERVICE_TOKEN=change-me-service
BABBEL_API_BASE_URL=http://localhost:8000

# --- Call behaviour (spec D2, FR-04, FR-05, D9) ---
BABBEL_QUIET_START=08:00
BABBEL_QUIET_END=20:00
BABBEL_CALL_TIME=10:30
BABBEL_MAX_CALL_MINUTES=12
BABBEL_RETRY_MINUTES=15
BABBEL_ESCALATION_WAIT=3
BABBEL_WELLBEING_MEDIUM_AFTER=3

# --- LiveKit + SIP trunk (D7) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_OUTBOUND_TRUNK_ID=
BABBEL_AGENT_NAME=babbel

# --- Models (D4-D6): any OpenAI-compatible endpoint, EU-hosted for the pilot ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_SMALL_MODEL=gpt-4.1-nano
LLM_JUDGE_MODEL=                 # evals only: a stronger model that grades conversations
STT_PROVIDER=openai
STT_MODEL=gpt-4o-transcribe
TTS_PROVIDER=openai
TTS_VOICE=alloy
TTS_SPEED=0.92
OPENAI_API_KEY=

# --- Cost rates in EUR (FR-51, NFR-02) ---
RATE_TELEPHONY_PER_MIN=0.015
RATE_STT_PER_MIN=0.006
RATE_TTS_PER_1K_CHARS=0.015
RATE_LLM_IN_PER_1M=0.4
RATE_LLM_OUT_PER_1M=1.6
COST_ALERT_PER_MIN=0.08

# --- Notifications (D10) ---
BABBEL_NOTIFIER=console          # console | webhook
SMS_WEBHOOK_URL=
BABBEL_OPERATOR_PHONE=

# --- Help requests and topics (FR-14, FR-16, D13, D14) ---
BABBEL_PARTNER_NAME=Helpper
BABBEL_PARTNER_PHONE=
BABBEL_TOPIC_FEEDS=config/topic_feeds.yaml

# --- Model selection (docs/model-selection.md); only the ones you test ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
SPEECHMATICS_API_KEY=
